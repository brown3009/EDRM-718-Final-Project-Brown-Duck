**9. Create a code chunk in which you redo all the previous items. First, clear the environment. Then read in the data and fix problems (if necessary) as you did before. Finally, show how to tidy the data in one set of piped functions.**

```{r}

# Step 1: Clear environment.

rm(list = ls())

# Importing Johnson Elementary Data.

johnson_ela <- read_csv(
  file = here("data", "Johnson Elementary ELA Project.csv"),
  col_names = c("Room", "ID", "Tard_Abs", "Q1", "Q2", "Q3", "Q4"),
  col_types = cols(
    Room = col_character(),
    ID = col_integer(),
    Tard_Abs = col_character(),
    Q1 = col_integer(),
    Q2 = col_integer(),
    Q3 = col_integer(),
    Q4 = col_integer()
  ),
  skip = 1
)

# Remove the first three rows after the header.

johnson_ela_clean <- johnson_ela %>%
  slice(-1:-3)

# Filling in the Room values.

johnson_ela_filled <- johnson_ela_clean %>%
  fill(Room, .direction = "down")

# Filtering out rows that do not contain any project data.

johnson_ela_cleaned2 <- johnson_ela_filled %>%
  filter(if_any(c(ID, Tard_Abs, Q1, Q2, Q3, Q4), ~ !is.na(.)))

# Separating Room into Temp and Room.

johnson_ela_split <- johnson_ela_cleaned2 %>%
  separate(col = Room, into = c("Temp", "Room"), sep = " ")

# Deleting the Temp variable.

johnson_ela_final <- johnson_ela_split %>%
  select(-Temp)

# Separating Tard_Abs into Tardies.

johnson_ela_final <- johnson_ela_final %>%
  separate(Tard_Abs, into = c("Tardies", "Absences"), sep = ";", convert = TRUE)

# Changing the *Q1*, *Q2*, *Q3*, and *Q4* variables into two variables.

johnson_ela_final <- johnson_ela_final %>%
  pivot_longer(
    cols = starts_with("Q"),
    names_to = "Quarter",
    values_to = "Rating"
  )

# Viewing the result.

print(johnson_ela_final, n = 20)

```



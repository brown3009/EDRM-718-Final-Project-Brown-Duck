**4. Tidy the *messy_patients.csv* file.**

```{r}

# Importing messy data.

messy_patients <- read.csv(here("data", "messy_patients.csv"))

# Tidying and sorting data.

tidy_patients <- messy_patients %>%
  pivot_longer(
    cols = -ID,
    names_to = "Treatment_Day",
    values_to = "Score"
  ) %>%
  separate(Treatment_Day, into = c("Treatment", "Day"), sep = "_") %>%
  replace_na(list(Score = NA)) %>%
  arrange(Treatment)

# Exporting data.

write_csv(tidy_patients, here("data", "tidy_patients.csv"))

# Displaying data.

print(tidy_patients, n = Inf, width = Inf)

```




**2. Tidy the *messy_weather.csv* file.**

```{r}

# Importing messy data.

messy_weather <- read.csv(here("data", "messy_weather.csv"))

# Tidying and sorting data.

tidy_weather <- messy_weather %>%
  pivot_longer(
    cols = c(Morning_Temp, Afternoon_Temp),
    names_to = "Time",
    values_to = "Temperature"
  ) %>%
  mutate(Time = str_remove(Time, "_Temp")) %>%
  replace_na(list(Temperature = NA)) %>%
  arrange(Location)

# Exporting data.

write_csv(tidy_weather, here("data", "tidy_weather.csv"))

# Displaying data.

tidy_weather
```


